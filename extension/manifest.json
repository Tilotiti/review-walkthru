{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.5.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "minimum_chrome_version": "155",
  "permissions": ["activeTab", "contextMenus", "webRequest", "storage", "scripting"],
  "host_permissions": [
    "http://localhost/*", "https://localhost/*",
    "http://*.localhost/*", "https://*.localhost/*",
    "http://127.0.0.1/*", "https://127.0.0.1/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "__MSG_actionTitle__", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "commands": {
    "comment": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "__MSG_commandComment__" }
  },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_end" },
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://*.localhost/*", "https://*.localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"],
      "js": ["console.js"], "run_at": "document_start", "world": "MAIN"
    },
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://*.localhost/*", "https://*.localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"],
      "js": ["dom.js", "overlay.js", "app.js"], "run_at": "document_idle"
    }
  ]
}
